# FastDL-WON (docker-compose.yml) - copy to .env and adjust
#
# One tree per mod/server: name=folder (folder relative to DATA_DIR). The name is the last path segment of
# that server's sv_won_downloadurl (a-z 0-9 _ -, max 32).
FASTDL_TREES="cstrike=cstrike cstrk13=cstrk13"
# Host name or IP players reach the web server under (for the printed server.cfg lines)
PUBLIC_HOST=fastdl.example.org
# Public TCP port of the web server
PORT=27980

# ---- only if needed ---------------------------------------------------------------------------------------
# Folder that holds the mod folders. Default ../config: this folder is docker-hlds-won2/fastdl-won.
# Standalone: the folder of your game server's mod folders. FastDL-WON writes only below
# DATA_DIR/fastdl-won (web root dl/, logs/); the trees hardlink the game files, which needs this one folder.
#DATA_DIR=/path/to/hlds
# The build runs as the owner of DATA_DIR. Set both only if DATA_DIR belongs to root, or if logs/ is on a
# file system without ACLs (then FASTDL_GID is the group the web server writes the access log through).
#FASTDL_UID=1000
#FASTDL_GID=1000
# server.cfg per tree for "docker compose run --rm build check" (default: <folder>/server.cfg)
#FASTDL_SERVERCFG="cstrike=cstrike/server.cfg"
# Container name of the web server (default fastdl-won)
#FASTDL_WEB_NAME=fastdl-won
# Optional HTTPS (docker-compose.tls.yml): folder with fullchain.pem + privkey.pem for PUBLIC_HOST, and its port.
# Enable with COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml and an https:// sv_won_downloadurl.
#TLS_DIR=/etc/letsencrypt/live/fastdl.example.org
#TLS_PORT=443
#COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
